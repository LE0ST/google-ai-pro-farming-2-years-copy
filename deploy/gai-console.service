[Unit]
Description=GaiConsole read-only subscription diagnostics
Documentation=https://github.com/LE0ST/google-ai-pro-farming-2-years-copy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/gai-console-read-only
Environment=GAI_BIND_HOST=127.0.0.1
Environment=GAI_BIND_PORT=8765
ExecStart=%h/gai-console-read-only/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8765 --log-level warning
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes

[Install]
WantedBy=default.target
